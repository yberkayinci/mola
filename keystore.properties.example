# Copy to keystore.properties for a local release build. Never commit the real file.
# CI reads the same four values from MOLA_KEYSTORE_FILE, MOLA_KEYSTORE_PASSWORD,
# MOLA_KEY_ALIAS and MOLA_KEY_PASSWORD instead.
# Without these, `assembleRelease` still succeeds and produces an unsigned APK.
storeFile=/absolute/path/to/mola-release.jks
storePassword=
keyAlias=mola
keyPassword=
